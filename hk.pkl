amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

// Detached fork with legacy C++: only cheap hygiene and CI workflow checks.
// C++ sources, libs/ and submodules are intentionally not linted.
local linters = new Mapping<String, Step> {
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["actionlint"] = (Builtins.actionlint) {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }

  ["check"] {
    steps = linters
  }

  ["fix"] {
    fix = true
    steps = linters
  }

  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = "hk util check-conventional-commit {{commit_msg_file}}"
      }
    }
  }
}
